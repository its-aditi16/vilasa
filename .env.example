# Copy this file to .env and fill in your key. .env is git-ignored. Never commit it.
GNANI_API_KEY=

# Leave blank to auto-detect: mock mode turns on when GNANI_API_KEY is empty.
# Set to 1 to force mock mode (no credits used), 0 to force live calls.
VILASA_MOCK=

# Speech-to-text (Prisma v3.0)
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
# transcribe = native script + digits (recommended). verbatim | transcribe | codemix | transliterate
GNANI_STT_FORMAT=transcribe

# Text-to-speech (Timbre v3.0)
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Chetana
GNANI_TTS_SAMPLE_RATE=16000

# Which PIN-code file the app loads
VILASA_PIN_FILE=data/pincodes_tumakuru.json
